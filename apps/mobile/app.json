{
  "expo": {
    "name": "Co-Heart",
    "slug": "coheart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "coheart",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yia.coheart",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yia.coheart",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Co-Heart uses your photos so you can add a profile picture for you or your learner.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Co-Heart uses Face ID so your learner can sign in quickly and securely."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
